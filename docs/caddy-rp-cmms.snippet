# ─────────────────────────────────────────────────────────────────────────
# Caddy gate для КП RP-CMMS — ОТДЕЛЬНЫЙ токен, доступ только к этому КП.
#
# Контекст: весь rp-kp.asystem.ai уже за общим token-gate (см.
# docs/caddy-rp-kp.snippet, токен {$RPKP_TOKEN}). Этот КП лежит по пути
# /rp-cmms/ и должен открываться СВОИМ токеном, не общим — чтобы выдать
# доступ отдельному отделу/получателю, не открывая остальные КП.
#
# Сгенерировать токен (НЕ переиспользовать общий):
#   openssl rand -hex 16        # → значение для {$RPCMMS_TOKEN}
#
# Применять ТОЛЬКО так (общий прокси на много доменов — ошибка уронит всё):
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
# Перед правкой — бэкап: cp /etc/caddy/aioskg.conf /etc/caddy/aioskg.conf.bak.cmms.$(date +%Y%m%d-%H%M%S)
#
# Персональная ссылка получателю:
#   https://rp-kp.asystem.ai/rp-cmms/?token={$RPCMMS_TOKEN}&u=<метка>
# ─────────────────────────────────────────────────────────────────────────


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ ВАРИАНТ A (рекомендуется) — path-гейт внутри существующего блока      ║
# ║ rp-kp.asystem.ai. Без новых DNS-записей и сертификатов.               ║
# ║                                                                       ║
# ║ Эти блоки вставить В НАЧАЛО блока `rp-kp.asystem.ai { … }`, ДО общих   ║
# ║ handle-ов из caddy-rp-kp.snippet. Caddy матчит по порядку — путь      ║
# ║ /rp-cmms* перехватывается раньше общего gate и проверяет СВОЙ токен.  ║
# ╚═══════════════════════════════════════════════════════════════════════╝

	# ВАЖНО: страница rp-cmms самодостаточна — все её ассеты (site.css, assets/*,
	# site.js) лежат ВНУТРИ /rp-cmms/, поэтому cookie с Path=/rp-cmms покрывает
	# и страницу, и её ассеты. Зависимости от корневых /site.css и т.п. нет.

	# --- RP-CMMS: вход по своему ?token= → cookie на 30 дней ---
	@cmms_token {
		path /rp-cmms /rp-cmms/*
		query token={$RPCMMS_TOKEN}
	}
	handle @cmms_token {
		header +Set-Cookie "asystem_cmms={$RPCMMS_TOKEN}; Path=/rp-cmms; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"
		reverse_proxy UPSTREAM_HERE     # тот же upstream, что у общего блока rp-kp
	}

	# --- RP-CMMS: уже впущенные по cookie этого КП ---
	@cmms_ok {
		path /rp-cmms /rp-cmms/*
		header_regexp Cookie "asystem_cmms={$RPCMMS_TOKEN}"
	}
	handle @cmms_ok {
		reverse_proxy UPSTREAM_HERE
	}

	# --- RP-CMMS: путь без СВОЕГО токена → 401. Общий токен rp-kp сюда НЕ пускает ---
	@cmms_block path /rp-cmms /rp-cmms/*
	handle @cmms_block {
		respond "Unauthorized" 401
	}

	# ↓↓↓ ниже идут существующие общие handle-ы блока rp-kp (token/cookie/basic).
	#     Изоляция в обе стороны:
	#     • новый токен ставит cookie asystem_cmms → проходит только @cmms_*,
	#       а на / и /redledger общий gate требует asystem_auth → 401 (чужие КП закрыты);
	#     • старый токен (asystem_auth) на /rp-cmms* ловится @cmms_block → 401. ↓↓↓


# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ ВАРИАНТ B — отдельный поддомен rp-cmms.asystem.ai.                     ║
# ║ Нужна A-запись DNS на тот же хост (orion) + авто-TLS Caddy.            ║
# ║ Проксирует на тот же контейнер, но переписывает путь в /rp-cmms/.      ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# rp-cmms.asystem.ai {
# 	header {
# 		X-Robots-Tag "noindex, nofollow, noarchive"
# 		-Server
# 	}
#
# 	# отдаём контент из подпапки /rp-cmms репозитория rp-kp
# 	rewrite * /rp-cmms{uri}
#
# 	@token query token={$RPCMMS_TOKEN}
# 	handle @token {
# 		header Set-Cookie "asystem_cmms={$RPCMMS_TOKEN}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"
# 		reverse_proxy UPSTREAM_HERE
# 	}
# 	@cookie header_regexp cmms Cookie "asystem_cmms={$RPCMMS_TOKEN}"
# 	handle @cookie {
# 		reverse_proxy UPSTREAM_HERE
# 	}
# 	handle {
# 		respond "401 Unauthorized" 401
# 	}
# }

# Примечания:
# • UPSTREAM_HERE — тот же адрес, что в текущем блоке rp-kp (Coolify-контейнер,
#   из памяти: 10.10.20.10:3002). Сверить с живым конфигом перед вставкой.
# • assets (../site.css, ../assets/*) лежат в корне репозитория rp-kp и грузятся
#   относительно /rp-cmms/ — в Варианте A работают как есть; в Варианте B их
#   тянет rewrite на /rp-cmms{uri} только для документа, а ../-ассеты резолвятся
#   в корень → проверить, что поддомен отдаёт и корневые пути (или не переписывать
#   пути ассетов). Вариант A этой проблемы лишён — поэтому он рекомендуется.
# • robots.txt в репо уже Disallow: / — индексация закрыта и для подпути.
